  "machines": [
    {
      "id": "PC9821",
      "label": "NEC PC-9801 / PC-9821, IA-32 CPU",
      "when": [
        "PC9821"
      ],
      "extensions": {
        ".d88": "PC9821",
        ".88d": "PC9821",
        ".d98": "PC9821",
        ".98d": "PC9821",
        ".fdi": "PC9821",
        ".hdm": "PC9821",
        ".xdf": "PC9821",
        ".dup": "PC9821",
